# ==============================================================================
# Environment Configuration Template (Production)
# Semua variabel di file ini otomatis dimuat ke Docker Compose melalui env_file
# ==============================================================================

# Application Configuration
PORT=8080
APP_PORT=8080

# Session Configuration (Wajib diisi - format durasi Go: e.g. 30m, 2h, 24h)
SESSION_ABSOLUTE_TTL=24h
SESSION_IDLE_TIMEOUT=2h

# Initial Admin Seeding (Otomatis dibuat saat aplikasi pertama kali dijalankan)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_to_a_secure_admin_password

# Internal PostgreSQL Configuration (Digunakan oleh service DB internal)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_this_to_a_secure_db_password
POSTGRES_DB=wbd
# Port Postgres di host (gunakan 5433 jika 5432 di host sudah dipakai aplikasi lain)
DB_PORT=5432

# Database Connection URL (Koneksi aplikasi ke service db di dalam network docker)
DATABASE_URL=postgres://postgres:change_this_to_a_secure_db_password@db:5432/wbd?sslmode=disable
