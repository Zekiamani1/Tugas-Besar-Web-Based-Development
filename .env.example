PORT=8080
APP_PORT=8080
SESSION_ABSOLUTE_TTL=24h
SESSION_IDLE_TIMEOUT=2h
SESSION_ROTATION_INTERVAL=15m
SESSION_ROTATION_GRACE_PERIOD=30s
SESSION_COOKIE_SECURE=true
